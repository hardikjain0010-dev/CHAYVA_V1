# Copy this file to .env and fill in real values.
# Nothing here is required to run the API locally — without these,
# the app falls back to an in-memory database and dev-mode auth.

# --- Firebase ---
# Path to your service account JSON (local dev)
FIREBASE_CREDENTIALS_PATH=
# OR: raw JSON string (useful for hosts like Render where you can't upload files)
FIREBASE_CREDENTIALS_JSON=

# --- AI provider keys (wire these into services/ai_service.py) ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# --- AI Model Names (required for AI Engine) ---
GEMINI_MODEL=gemini-2.0-flash-exp
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_REASONING_MODEL=deepseek/deepseek-r1
OPENROUTER_SUMMARY_MODEL=deepseek/deepseek-chat

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# --- App ---
ENV=development
CORS_ORIGINS=http://localhost:5173
AI_CALLS_PER_HOUR=30
DAILY_COST_ALERT_THRESHOLD=50

# --- Authentication (JWT & Google) ---
JWT_SECRET_KEY=change-me-in-production
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
